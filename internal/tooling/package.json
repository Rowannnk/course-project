{
  "name": "tooling",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./eslint": "./eslint.js",
    "./prettier": "./prettier.config.js",
    "./tsconfig.base.json": "./tsconfig.base.json"
  },
  "scripts": {
    "lint": "pnpm run \"/^lint-.*/\"",
    "lint-eslint": "eslint .",
    "lint-prettier": "prettier --check .",
    "lint-knip": "knip --directory ../.. --workspace internal/tooling",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "catalog:",
    "knip": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.2"
  }
}
