{
  "name": "@platform/quiz",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    "./*": "./src/*/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "pnpm run \"/^lint-.*/\"",
    "lint-typecheck": "tsc --noEmit",
    "lint-eslint": "eslint .",
    "lint-prettier": "prettier --check .",
    "lint-knip": "knip --directory ../.. --workspace features/quiz",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@platform/tooling": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "knip": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
