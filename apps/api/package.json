{
  "name": "@platform/api",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.ts",
  "imports": {
    "#shared/*": "./src/shared/*/index.ts"
  },
  "scripts": {
    "lint": "pnpm run \"/^lint-.*/\"",
    "lint-typecheck": "tsc --noEmit",
    "lint-eslint": "eslint .",
    "lint-prettier": "prettier --check .",
    "lint-knip": "knip --directory ../.. --workspace apps/api",
    "format": "prettier --write .",
    "dev": "nodemon src/index.ts",
    "start": "node ."
  },
  "dependencies": {
    "@platform/quiz": "workspace:*",
    "fastify": "^5.8.0"
  },
  "devDependencies": {
    "@platform/tooling": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "knip": "catalog:",
    "nodemon": "^3.1.10",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
