{
  "name": "@platform/cli",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "lint": "pnpm run \"/^lint-.*/\"",
    "lint-typecheck": "tsc --noEmit",
    "lint-eslint": "eslint .",
    "lint-prettier": "prettier --check .",
    "lint-knip": "knip --directory ../.. --workspace apps/cli",
